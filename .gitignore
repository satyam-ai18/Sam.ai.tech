# ─────────────────────────────────────────────
# MK Convent School — .gitignore
# ─────────────────────────────────────────────

# ── Dependencies ──────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Next.js Build Output ──────────────────────
.next/
out/

# ── Production Build ──────────────────────────
build/
dist/

# ── Environment Variables (NEVER commit these) ─
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ── Prisma ────────────────────────────────────
# SQLite database file (local only)
prisma/*.db
prisma/*.db-journal
prisma/*.db-shm
prisma/*.db-wal

# Generated Prisma Client (regenerated on install)
# DO NOT ignore: prisma/schema.prisma
# DO NOT ignore: prisma/seed.ts

# ── TypeScript Build Info ─────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Vercel ────────────────────────────────────
.vercel/

# ── Debug Logs ───────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS Files ─────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── IDE / Editor ─────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Testing ───────────────────────────────────
coverage/
.nyc_output/

# ── Misc ──────────────────────────────────────
*.log
.cache/
tmp/
temp/
backups/
