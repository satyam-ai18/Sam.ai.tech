# ─────────────────────────────────────────────────────────────
#  MK Convent School — Environment Variables Template
#  Copy this file to .env.local and fill in the values.
#  NEVER commit .env or .env.local to GitHub!
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# For local development (SQLite):
DATABASE_URL="file:./dev.db"

# For production on Vercel — use a cloud DB (e.g., Turso, PlanetScale, Supabase):
# DATABASE_URL="libsql://your-db.turso.io?authToken=YOUR_TOKEN"
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Auth (NextAuth.js) ────────────────────────────────────────
# Generate a secure random string: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS"

# Set to your production URL on Vercel:
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_URL="https://your-project.vercel.app"
